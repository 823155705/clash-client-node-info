#!name=节点检测工具
#!desc=长按节点查询入口与落地链路、IP 纯净度、流媒体及 AI 解锁状态。详细说明见 GitHub 主页。
#!openUrl=https://github.com/823155705/clash-client-node-info
#!author=823155705
#!tag=节点检测
#!system=iOS,iPadOS,macOS,tvOS
#!system_version=
#!loon_version=3.5.1(983)
#!homepage=https://github.com/823155705/clash-client-node-info
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Global.png
#!date=2026-11-17

[Argument]
SHOW_DOMESTIC = switch, true, tag = 显示本地直连
SHOW_ENTRANCE = switch, true, tag = 查询中转入口
CHECK_IPV6 = switch, true, tag = 检测 IPv6 支持
MASK_IP = switch, false, tag = IP 隐私打码
NOTIFY_ON_CHANGE = switch, false, tag = 网络切换通知
TIMEOUT_SEC = select, "8", "5", "12", "15", tag = 超时时间（秒）
IPAPI_KEY = input, "", tag = ipapi.is Key（选填）

[Host]
net-lsp-x.com = 198.51.100.88

[Rule]
DOMAIN, myip.ipip.net, DIRECT
DOMAIN, r.inews.qq.com, DIRECT
DOMAIN, 4.ipw.cn, DIRECT
DOMAIN, ip.3322.net, DIRECT
DOMAIN, whois.pconline.com.cn, DIRECT
DOMAIN, ip.netart.cn, DIRECT
DOMAIN, api-v3.speedtest.cn, DIRECT
DOMAIN, rmb.pingan.com.cn, DIRECT

[Script]
generic then script("https://raw.githubusercontent.com/823155705/clash-client-node-info/main/xream-node-info.js?v=3.1.0", {${SHOW_DOMESTIC}, ${SHOW_ENTRANCE}, ${CHECK_IPV6}, ${MASK_IP}, ${NOTIFY_ON_CHANGE}, ${TIMEOUT_SEC}, ${IPAPI_KEY}}) with tag="节点链路查询", img_url="globe.asia.australia.system", timeout=45

generic then script("https://raw.githubusercontent.com/823155705/clash-client-node-info/main/xream-node-info.js?v=3.1.0", {${SHOW_DOMESTIC}, ${SHOW_ENTRANCE}, ${CHECK_IPV6}, ${MASK_IP}, ${NOTIFY_ON_CHANGE}, ${TIMEOUT_SEC}, ${IPAPI_KEY}}) with tag="节点纯净度检测", img_url="shield.lefthalf.filled.system", timeout=50

generic then script("https://raw.githubusercontent.com/823155705/clash-client-node-info/main/xream-node-info.js?v=3.1.0", {${SHOW_DOMESTIC}, ${SHOW_ENTRANCE}, ${CHECK_IPV6}, ${MASK_IP}, ${NOTIFY_ON_CHANGE}, ${TIMEOUT_SEC}, ${IPAPI_KEY}}) with tag="流媒体与解锁检测", img_url="play.tv.system", timeout=60

network-changed then script("https://raw.githubusercontent.com/823155705/clash-client-node-info/main/xream-node-info.js?v=3.1.0", {${SHOW_DOMESTIC}, ${SHOW_ENTRANCE}, ${CHECK_IPV6}, ${MASK_IP}, ${NOTIFY_ON_CHANGE}, ${TIMEOUT_SEC}, ${IPAPI_KEY}}) with enable=${NOTIFY_ON_CHANGE}, tag="网络切换通知", timeout=45

request if ${url} ~= /^https?:\/\/net-lsp-x\.com/i then script("https://raw.githubusercontent.com/823155705/clash-client-node-info/main/xream-node-info.js?v=3.1.0", {${SHOW_DOMESTIC}, ${SHOW_ENTRANCE}, ${CHECK_IPV6}, ${MASK_IP}, ${NOTIFY_ON_CHANGE}, ${TIMEOUT_SEC}, ${IPAPI_KEY}}) with tag="网页诊断面板", timeout=45

[MitM]
hostname = net-lsp-x.com
