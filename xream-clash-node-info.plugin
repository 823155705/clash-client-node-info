#!name=节点检测工具
#!desc=长按节点查询入口与落地链路、IP 纯净度、流媒体及 AI 解锁状态。详细说明见 GitHub 主页。
#!author=小鸣
#!homepage=https://github.com/823155705/clash-client-node-info
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Global.png
#!date=2026-11-17

[Argument]
SHOW_DOMESTIC = switch, true, tag = 显示本地直连
SHOW_ENTRANCE = switch, true, tag = 查询中转入口
CONTROLLER_PORT = input, "9090", tag = 外部控制器端口
CONTROLLER_SECRET = input, "", tag = 外部控制器密钥, desc = 填入「客户端设置 -> 外部控制器 -> 本机」中的密钥以显示中转入口
CHECK_IPV6 = switch, true, tag = 检测 IPv6 支持
MASK_IP = switch, false, tag = IP 隐私打码
AUTO_SWITCH_FALLBACK = switch, true, tag = 未开解密时临时切换测速
NOTIFY_ON_CHANGE = switch, false, tag = 网络切换通知
TIMEOUT_SEC = select, "8", "5", "12", "15", tag = 超时时间（秒）
IPAPI_KEY = input, "", tag = ipapi.is Key（选填）

[General]
force-http-engine-hosts = net-lsp-x.com

[Host]
net-lsp-x.com = 198.51.100.88

[Rule]
DOMAIN,myip.ipip.net,DIRECT
DOMAIN,r.inews.qq.com,DIRECT
DOMAIN,4.ipw.cn,DIRECT
DOMAIN,ip.3322.net,DIRECT
DOMAIN,whois.pconline.com.cn,DIRECT
DOMAIN,ip.netart.cn,DIRECT
DOMAIN,api-v3.speedtest.cn,DIRECT
DOMAIN,rmb.pingan.com.cn,DIRECT

[Panel]
当前网络出口信息 = script-name=节点链路查询, title="当前网络出口信息", content="点击右上角刷新查看直连、中转入口与落地详情", icon=globe.asia.australia, icon-color=#3B82F6

[Script]
http-request ^https?:\/\/net-lsp-x\.com script-path=https://raw.githubusercontent.com/823155705/clash-client-node-info/main/xream-clash-node-bg.js?v=3.1.0, timeout=75, script-update-interval=86400, tag=节点直测桥接, argument="CLIENT=clash&MODE=bridge&SHOW_DOMESTIC={SHOW_DOMESTIC}&SHOW_ENTRANCE={SHOW_ENTRANCE}&CONTROLLER_PORT={CONTROLLER_PORT}&CONTROLLER_SECRET={CONTROLLER_SECRET}&CHECK_IPV6={CHECK_IPV6}&MASK_IP={MASK_IP}&TIMEOUT_SEC={TIMEOUT_SEC}&IPAPI_KEY={IPAPI_KEY}"

generic script-path=https://raw.githubusercontent.com/823155705/clash-client-node-info/main/xream-clash-node-info.js?v=3.1.0, timeout=90, script-update-interval=86400, tag=节点链路查询, img-url=globe.asia.australia, argument="CLIENT=clash&MODE=info&SHOW_DOMESTIC={SHOW_DOMESTIC}&SHOW_ENTRANCE={SHOW_ENTRANCE}&CONTROLLER_PORT={CONTROLLER_PORT}&CONTROLLER_SECRET={CONTROLLER_SECRET}&CHECK_IPV6={CHECK_IPV6}&MASK_IP={MASK_IP}&AUTO_SWITCH_FALLBACK={AUTO_SWITCH_FALLBACK}&TIMEOUT_SEC={TIMEOUT_SEC}"

generic script-path=https://raw.githubusercontent.com/823155705/clash-client-node-info/main/xream-clash-node-info.js?v=3.1.0, timeout=105, script-update-interval=86400, tag=节点纯净度检测, img-url=shield.lefthalf.filled, argument="CLIENT=clash&MODE=purity&MASK_IP={MASK_IP}&AUTO_SWITCH_FALLBACK={AUTO_SWITCH_FALLBACK}&TIMEOUT_SEC={TIMEOUT_SEC}&IPAPI_KEY={IPAPI_KEY}"

generic script-path=https://raw.githubusercontent.com/823155705/clash-client-node-info/main/xream-clash-node-info.js?v=3.1.0, timeout=120, script-update-interval=86400, tag=流媒体与解锁检测, img-url=play.tv, argument="CLIENT=clash&MODE=unlock&MASK_IP={MASK_IP}&AUTO_SWITCH_FALLBACK={AUTO_SWITCH_FALLBACK}&TIMEOUT_SEC={TIMEOUT_SEC}"

network-changed script-path=https://raw.githubusercontent.com/823155705/clash-client-node-info/main/xream-clash-node-bg.js?v=3.1.0, timeout=60, script-update-interval=86400, tag=网络切换通知, argument="CLIENT=clash&MODE=event&SHOW_DOMESTIC={SHOW_DOMESTIC}&SHOW_ENTRANCE={SHOW_ENTRANCE}&CONTROLLER_PORT={CONTROLLER_PORT}&CONTROLLER_SECRET={CONTROLLER_SECRET}&MASK_IP={MASK_IP}&NOTIFY_ON_CHANGE={NOTIFY_ON_CHANGE}&TIMEOUT_SEC={TIMEOUT_SEC}&IPAPI_KEY={IPAPI_KEY}"

[MITM]
hostname = net-lsp-x.com
