#!name=全能节点检测套件 (xream & 可莉适配版)
#!desc=融合 xream/scripts 与可莉仓库三大节点检测插件，专为 Clash-Client 定制三项独立长按菜单：① 节点链路与入口查询（直连➔中转入口含ASN➔落地双栈➔BGP上游骨干线路➔CF边缘与WARP识别）；② 节点纯净度深度检测（双 ISP 原生家宽 + BGP上游 + 三源风控黑名单审计）；③ 流媒体与 AI 解锁检测（ChatGPT / Claude / Gemini / Netflix / YouTube / Disney+ / TikTok / 动画疯）。
#!author=xream, Kelee & Contributors
#!homepage=https://github.com/823155705/clash-client-node-info
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Global.png
#!date=2026-11-14

[Argument]
SHOW_DOMESTIC = switch, true, tag = 显示本地直连对比, desc = 在「链路与入口查询」中同时展示国内直连 IP 与运营商
SHOW_ENTRANCE = switch, true, tag = 查询节点中转入口, desc = 配合「设置 -> 客户端设置 -> 外部控制器 -> 本机」自动抓取节点中转入口 IP 与运营商
CONTROLLER_PORT = input, "9090", tag = 外部控制器端口, desc = 对应「外部控制器 -> 本机」中的监听端口，默认 9090
CONTROLLER_SECRET = input, "", tag = 外部控制器密钥（查入口填写）, desc = 粘贴「外部控制器 -> 本机」页面显示的密钥即可显示节点中转入口
CHECK_IPV6 = switch, true, tag = 检测节点 IPv6 支持, desc = 检测所选节点是否具备双栈 IPv6 出站能力
MASK_IP = switch, false, tag = 隐私保护（IP 打码）, desc = 截图分享时自动隐藏 IP 中间网段与入口域名
AUTO_SWITCH_FALLBACK = switch, true, tag = 未开解密引擎时自动临时切换测速, desc = 未开启模块页顶部 HTTPS 解密开关时，临时路由至目标节点测速并自动还原
NOTIFY_ON_CHANGE = switch, false, tag = 网络环境切换通知, desc = Wi-Fi / 蜂窝网络切换且出口变化时推送通知
TIMEOUT_SEC = select, "8", "5", "12", "15", tag = 接口超时时间（秒）, desc = 慢速链路或流媒体解锁检测建议设为 8~12 秒
IPAPI_KEY = input, "", tag = ipapi.is Key（可选）, desc = 留空即可免 Key 使用；高频检测可填入免费申请的 Key

[General]
force-http-engine-hosts = net-lsp-x.com

[Host]
net-lsp-x.com = 198.51.100.88

[Rule]
DOMAIN,myip.ipip.net,DIRECT
DOMAIN,r.inews.qq.com,DIRECT
DOMAIN,4.ipw.cn,DIRECT
DOMAIN,ip.3322.net,DIRECT
DOMAIN,whois.pconline.com.cn,DIRECT

[Panel]
当前网络出口信息 = script-name=节点链路与入口查询, title="当前网络出口信息", content="点击右上角刷新查看直连、中转入口与落地详情", icon=globe.asia.australia, icon-color=#3B82F6

[Script]
http-request ^https?:\/\/net-lsp-x\.com script-path=https://raw.githubusercontent.com/823155705/clash-client-node-info/main/xream-clash-node-info.js?v=2.5.0, timeout=45, script-update-interval=86400, tag=节点直测桥接引擎, argument="MODE=bridge&SHOW_DOMESTIC={SHOW_DOMESTIC}&SHOW_ENTRANCE={SHOW_ENTRANCE}&CONTROLLER_PORT={CONTROLLER_PORT}&CONTROLLER_SECRET={CONTROLLER_SECRET}&CHECK_IPV6={CHECK_IPV6}&MASK_IP={MASK_IP}&TIMEOUT_SEC={TIMEOUT_SEC}&IPAPI_KEY={IPAPI_KEY}"

generic script-path=https://raw.githubusercontent.com/823155705/clash-client-node-info/main/xream-clash-node-info.js?v=2.5.0, timeout=30, script-update-interval=86400, tag=节点链路与入口查询, img-url=globe.asia.australia, argument="MODE=info&SHOW_DOMESTIC={SHOW_DOMESTIC}&SHOW_ENTRANCE={SHOW_ENTRANCE}&CONTROLLER_PORT={CONTROLLER_PORT}&CONTROLLER_SECRET={CONTROLLER_SECRET}&CHECK_IPV6={CHECK_IPV6}&MASK_IP={MASK_IP}&AUTO_SWITCH_FALLBACK={AUTO_SWITCH_FALLBACK}&TIMEOUT_SEC={TIMEOUT_SEC}"

generic script-path=https://raw.githubusercontent.com/823155705/clash-client-node-info/main/xream-clash-node-info.js?v=2.5.0, timeout=40, script-update-interval=86400, tag=节点纯净度深度检测, img-url=shield.lefthalf.filled, argument="MODE=purity&MASK_IP={MASK_IP}&AUTO_SWITCH_FALLBACK={AUTO_SWITCH_FALLBACK}&TIMEOUT_SEC={TIMEOUT_SEC}&IPAPI_KEY={IPAPI_KEY}"

generic script-path=https://raw.githubusercontent.com/823155705/clash-client-node-info/main/xream-clash-node-info.js?v=2.5.0, timeout=45, script-update-interval=86400, tag=流媒体与 AI 解锁检测, img-url=play.tv, argument="MODE=unlock&MASK_IP={MASK_IP}&AUTO_SWITCH_FALLBACK={AUTO_SWITCH_FALLBACK}&TIMEOUT_SEC={TIMEOUT_SEC}"

network-changed script-path=https://raw.githubusercontent.com/823155705/clash-client-node-info/main/xream-clash-node-info.js?v=2.5.0, timeout=25, script-update-interval=86400, tag=网络切换出口通知, argument="MODE=event&SHOW_DOMESTIC={SHOW_DOMESTIC}&SHOW_ENTRANCE={SHOW_ENTRANCE}&CONTROLLER_PORT={CONTROLLER_PORT}&CONTROLLER_SECRET={CONTROLLER_SECRET}&MASK_IP={MASK_IP}&NOTIFY_ON_CHANGE={NOTIFY_ON_CHANGE}&TIMEOUT_SEC={TIMEOUT_SEC}&IPAPI_KEY={IPAPI_KEY}"

[MITM]
hostname = net-lsp-x.com
