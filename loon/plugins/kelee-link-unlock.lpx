#!author=823155705
#!tag=外链直跳
#!system=iOS,iPadOS,macOS,tvOS
#!system_version=
#!loon_version=3.5.1(983)
#!homepage=https://github.com/823155705/clash-client-node-info
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Link.png
#!date=2026-11-17

[Script]
request if ${url} ~= /^https?:\/\/(weixin110\.qq\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi|c\.pc\.qq\.com\/(middlem|ios|index|pc)\.html|link\.zhihu\.com\/\?|sinaurl\.cn\/|link\.csdn\.net\/\?|link\.juejin\.cn\/\?|www\.jianshu\.com\/go-wild\?)/i then script("https://raw.githubusercontent.com/823155705/clash-client-node-info/main/plugins/kelee-link-unlock.js?v=3.1.0") with tag="外链直跳", timeout=10

[MitM]
hostname = weixin110.qq.com, c.pc.qq.com, link.zhihu.com, sinaurl.cn, link.csdn.net, link.juejin.cn, www.jianshu.com
