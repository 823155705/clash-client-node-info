[Script]
http-request ^https?:\/\/(weixin110\.qq\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi|c\.pc\.qq\.com\/(middlem|ios|index|pc)\.html|link\.zhihu\.com\/\?|sinaurl\.cn\/|link\.csdn\.net\/\?|link\.juejin\.cn\/\?|www\.jianshu\.com\/go-wild\?) script-path=https://raw.githubusercontent.com/823155705/clash-client-node-info/main/plugins/kelee-link-unlock.js?v=3.1.0, timeout=10, script-update-interval=86400, tag=外链直跳

[MITM]
hostname = weixin110.qq.com, c.pc.qq.com, link.zhihu.com, sinaurl.cn, link.csdn.net, link.juejin.cn, www.jianshu.com
