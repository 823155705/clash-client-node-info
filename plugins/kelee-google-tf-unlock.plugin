#!name=Google 与 TestFlight 解锁
#!desc=将 google.cn 重定向至 google.com，并解除 TestFlight 区域限制。
#!author=823155705
#!homepage=https://github.com/823155705/clash-client-node-info
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Google_Search.png
#!date=2026-11-17

[Rewrite]
^https?:\/\/(www\.)?(g|google)\.cn https://www.google.com 302
^https?:\/\/(ditu|maps)\.google\.cn https://maps.google.com 302

[Script]
http-request ^https?:\/\/testflight\.apple\.com\/v\d\/accounts\/[^/]+\/install$ script-path=https://raw.githubusercontent.com/823155705/clash-client-node-info/main/plugins/kelee-tf-unlock.js?v=3.1.0, requires-body=true, timeout=10, script-update-interval=86400, tag=TestFlight区域解锁

[MITM]
hostname = www.google.cn, google.cn, www.g.cn, g.cn, ditu.google.cn, maps.google.cn, testflight.apple.com
