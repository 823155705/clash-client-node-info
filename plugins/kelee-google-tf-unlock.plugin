#!name=Google 防送中与 TestFlight 跨区解锁 (可莉仓库适配版)
#!desc=移植自可莉插件仓库「Google搜索重定向 + TestFlight地区解锁」。自动将 google.cn / g.cn 重定向至 www.google.com，并解除 TestFlight 安装测试版应用时的 Apple ID 区域商店限制（需开启 HTTPS 解密并信任证书）。
#!author=Kelee & Contributors
#!homepage=https://github.com/823155705/clash-client-node-info
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Google_Search.png
#!date=2026-11-17

[Rewrite]
^https?:\/\/(www\.)?(g|google)\.cn https://www.google.com 302
^https?:\/\/(ditu|maps)\.google\.cn https://maps.google.com 302

[Script]
http-request ^https?:\/\/testflight\.apple\.com\/v\d\/accounts\/[^/]+\/install$ script-path=https://raw.githubusercontent.com/823155705/clash-client-node-info/main/plugins/kelee-tf-unlock.js?v=3.0.0, requires-body=true, timeout=10, script-update-interval=86400, tag=TestFlight区域解锁

[MITM]
hostname = www.google.cn, google.cn, www.g.cn, g.cn, ditu.google.cn, maps.google.cn, testflight.apple.com
